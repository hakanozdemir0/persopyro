[Unit]
Description=PersoPyro Django web application (Gunicorn)
After=network.target postgresql.service

[Service]
Type=simple
User=hakan
Group=hakan
WorkingDirectory=/home/hakan/persopyro
EnvironmentFile=/home/hakan/persopyro/.env
EnvironmentFile=/home/hakan/persopyro/deploy/systemd/persopyro-preview.env
ExecStart=/home/hakan/persopyro/.venv/bin/gunicorn --bind 127.0.0.1:8000 --workers 2 --access-logfile - --error-logfile - config.wsgi:application
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
