# Persopyro — ortam değişkenleri ÖRNEĞİ
# Gerçek değerler buraya yazılmaz. Kopyalayıp .env olarak kullanın (.env git'e girmez).

# --- Django ---
# Üretimde tanımlı olması ZORUNLUDUR (tanımsızsa uygulama başlamaz).
DJANGO_SECRET_KEY=
# Geliştirmede 1, üretimde 0 (veya hiç tanımlamayın).
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=persopyro
POSTGRES_USER=persopyro_app
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Arka plan görevleri (django-q2) ---
Q_WORKERS=2

# --- E-posta ---
# Geliştirmede boş bırakılır (konsola yazılır).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Persopyro <no-reply@example.com>

# --- Nesne depolama (S3 uyumlu) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SIGNED_URL_TTL_SECONDS=300

# --- Hata izleme (opsiyonel) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
